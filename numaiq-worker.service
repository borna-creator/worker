[Unit]
Description=NumaIQ QA Worker (VPS 2)
After=network.target

[Service]
Type=simple
# Match the user that owns /var/www/worker on your VPS (root or generaladmin)
User=root
WorkingDirectory=/var/www/worker
EnvironmentFile=/var/www/worker/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
